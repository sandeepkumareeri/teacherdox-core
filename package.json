{
  "name": "teacherdox-core",
  "version": "0.2.0",
  "description": "Teaching documentation infrastructure for the world: the open .tdx record, a multimodal record engine on Meta's models, and verifiable trust.",
  "license": "Apache-2.0",
  "main": "src/tdx/index.js",
  "bin": {
    "tdx": "bin/tdx"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.json",
    "coverage": "node --test --experimental-test-coverage test/*.test.js",
    "serve": "node bin/tdx serve",
    "build:verifier": "node -e \"require('fs').writeFileSync('verifier/tdx-verify.js', require('./src/verifier').buildBrowserBundle())\"",
    "build:sample": "node scripts/make-sample.js",
    "eval": "node eval/run.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sandeepkumareeri/teacherdox-core"
  },
  "keywords": [
    "teaching",
    "education",
    "records",
    "verifiable",
    "tdx",
    "whatsapp",
    "meta",
    "muse"
  ],
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-prometheus": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-grpc": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/instrumentation-redis": "^0.72.0",
    "@opentelemetry/instrumentation-winston": "^0.69.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^16.3.0",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "6.0.2"
  }
}
